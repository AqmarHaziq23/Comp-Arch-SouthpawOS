# Settings for the auto-started programs (pi/services/*.service).
# pi/install.sh copies this file to pi/southpaw.env the first time. Change southpaw.env, not this file,
# then apply it with:  sudo systemctl restart southpaw-hub   (or -nfc / -vision)
# southpaw.env is git-ignored, so the website token below never ends up on GitHub.

# The game (python -m southpaw play boards.toml ...). Defaults: 3 rounds of 30 s, 20 s rest.
# Example for a short demo game:  HUB_ARGS=--rounds 1 --round-secs 30 --rest-secs 15
HUB_ARGS=

# Jovis's website: the hub uploads every round there. Leave empty for no upload.
SOUTHPAW_SERVER=
INGEST_TOKEN=

# The NFC reader, for example --bus 6 if the reader is on another I2C bus
NFC_ARGS=

# Vision, for example --source 1 for another webcam
VISION_ARGS=

# At boot, Wi-Fi stays off until the 3 boards have connected, for at most this many seconds
# (pi/bluetooth_first.sh). 2.4 GHz Wi-Fi stops the boards connecting in a busy room. 0 = off.
BT_FIRST_SECS=180
