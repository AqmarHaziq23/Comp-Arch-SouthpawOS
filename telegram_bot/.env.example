# Southpaw OS Telegram bot settings
# Copy this file to .env and fill it in:   copy .env.example .env   (Windows)   /   cp .env.example .env   (Pi)
# .env is git-ignored: NEVER commit your real token. If it leaks, send /revoke to @BotFather.

# The token @BotFather gave you when you created the bot
TELEGRAM_BOT_TOKEN=put-your-token-here

# Where the bot listens for the hub and NFC reader (port 5007; 5006 is the hub's NFC port).
# Keep 127.0.0.1 so only programs on the same machine can send
HUB_LISTEN_HOST=127.0.0.1
HUB_LISTEN_PORT=5007

# Local database file (card links + round history)
DB_PATH=players.db

# How long a player has to tap their card after sending /link (seconds)
LINK_TIMEOUT_S=60
