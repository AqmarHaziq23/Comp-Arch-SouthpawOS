# Copy to .env and change all three. .env is gitignored: never commit real values.
# Use letters and numbers only for the database password (it goes inside a URL).

# Password of the Postgres database inside Docker
POSTGRES_PASSWORD=change-me

# Signs the login cookies. Any long random text.
SECRET_KEY=change-me-to-something-long-and-random

# Shared secret the Pi sends with every upload (Authorization: Bearer <token>)
INGEST_TOKEN=change-me-too
